#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] Linting repo..."
npm run -s lint
(
  cd client && npm run -s lint
)

echo "[pre-commit] Type-checking packages..."
npx -y tsc -p client/tsconfig.json --noEmit
npx -y tsc -p server/tsconfig.json --noEmit
npx -y tsc -p shared/tsconfig.json --noEmit

# Documentation Tracker Validation
echo "[pre-commit] Validating documentation..."
if [ -d "scripts/doc-tracker" ]; then
  cd scripts/doc-tracker
  if [ -f "package.json" ]; then
    npm run validate 2>/dev/null || {
      echo "⚠️ Documentation validation warnings found"
      if [ "$DOC_TRACKER_STRICT" = "true" ]; then
        echo "❌ Commit rejected due to documentation validation errors"
        echo "Run 'npm run docs:fix' to automatically fix issues"
        exit 1
      else
        echo "⚠️ Proceeding with warnings (set DOC_TRACKER_STRICT=true to block)"
      fi
    }
  fi
  cd ../..
fi

echo "[pre-commit] OK"

