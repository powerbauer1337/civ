#!/bin/bash

# god-cli-test - Comprehensive Integration Test Suite
# Tests all god-cli components and their integration
# Usage: god-cli-test [test-category] [--verbose]

set -euo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly VERSION="1.0.0"
readonly CONFIG_DIR="${HOME}/.god-cli"
readonly LOG_FILE="${CONFIG_DIR}/logs/test.log"
readonly TEST_RESULTS_DIR="${CONFIG_DIR}/test-results"

# Test configuration
readonly TEMP_TEST_DIR="/tmp/god-cli-tests"
readonly TEST_TIMEOUT=30

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# Ensure directories exist
mkdir -p "$CONFIG_DIR"/{logs,test-results} "$TEMP_TEST_DIR"

# Logging functions
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log_debug() {
    if [[ "${VERBOSE:-}" = "1" ]]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] DEBUG: $*" | tee -a "$LOG_FILE" >&2
    fi
}

# Test result tracking
declare -A test_results
declare -a failed_tests=()
declare -a passed_tests=()
declare -a skipped_tests=()

# Test assertion functions
assert_success() {
    local test_name="$1"
    local command="$2"
    
    log_debug "Running test: $test_name"
    log_debug "Command: $command"
    
    if timeout "$TEST_TIMEOUT" bash -c "$command" >/dev/null 2>&1; then
        test_results["$test_name"]="PASS"
        passed_tests+=("$test_name")
        echo -e "${GREEN}✓${NC} $test_name"
        return 0
    else
        local exit_code=$?
        test_results["$test_name"]="FAIL"
        failed_tests+=("$test_name")
        echo -e "${RED}✗${NC} $test_name (exit code: $exit_code)"
        return 1
    fi
}

assert_contains() {
    local test_name="$1"
    local command="$2"
    local expected_text="$3"
    
    log_debug "Running contains test: $test_name"
    log_debug "Command: $command"
    log_debug "Expected: $expected_text"
    
    local output
    if output=$(timeout "$TEST_TIMEOUT" bash -c "$command" 2>&1) && echo "$output" | grep -q "$expected_text"; then
        test_results["$test_name"]="PASS"
        passed_tests+=("$test_name")
        echo -e "${GREEN}✓${NC} $test_name"
        return 0
    else
        test_results["$test_name"]="FAIL"
        failed_tests+=("$test_name")
        echo -e "${RED}✗${NC} $test_name (expected: $expected_text)"
        [[ "${VERBOSE:-}" = "1" ]] && echo "Actual output: $output"
        return 1
    fi
}

skip_test() {
    local test_name="$1"
    local reason="$2"
    
    test_results["$test_name"]="SKIP"
    skipped_tests+=("$test_name")
    echo -e "${YELLOW}⚠${NC} $test_name (skipped: $reason)"
}

# Test categories
test_basic_functionality() {
    echo -e "\n${BLUE}=== Basic Functionality Tests ===${NC}"
    
    # Test script existence and permissions
    assert_success "Scripts are executable" "
        [[ -x './scripts/god-cli' ]] && 
        [[ -x './scripts/god-cli-workflow' ]] && 
        [[ -x './scripts/god-cli-cache' ]] && 
        [[ -x './scripts/god-cli-monitor' ]] &&
        [[ -x './scripts/god-cli-fallback' ]]
    "
    
    # Test help commands
    assert_contains "god-cli help works" "./scripts/god-cli --help" "Unified Multi-Agent Command Interface"
    assert_contains "workflow help works" "./scripts/god-cli-workflow --help" "Parallel Workflow Orchestration"
    assert_contains "cache help works" "./scripts/god-cli-cache --help" "Intelligent Context Caching"
    assert_contains "monitor help works" "./scripts/god-cli-monitor --help" "Performance Monitoring"
    assert_contains "fallback help works" "./scripts/god-cli-fallback --help" "Fallback and Error Handling"
    
    # Test system status
    assert_contains "System status check" "./scripts/god-cli status" "God-CLI System Status"
}

test_agent_availability() {
    echo -e "\n${BLUE}=== Agent Availability Tests ===${NC}"
    
    # Test individual agent availability
    if command -v codex >/dev/null || [[ -x "./scripts/safe-codex-exec" ]]; then
        assert_contains "Codex agent available" "./scripts/god-cli status" "codex: Available"
    else
        skip_test "Codex agent test" "codex not installed"
    fi
    
    if command -v gemini >/dev/null; then
        assert_contains "Gemini agent available" "./scripts/god-cli status" "gemini: Available"
    else
        skip_test "Gemini agent test" "gemini not installed"
    fi
    
    assert_contains "Claude agent available" "./scripts/god-cli status" "claude: Available"
    
    # Test fallback health check
    assert_contains "Health check works" "./scripts/god-cli-fallback health" "God-CLI System Health Check"
}

test_context_management() {
    echo -e "\n${BLUE}=== Context Management Tests ===${NC}"
    
    # Test context lifecycle
    local test_context="test-integration-$$"
    
    assert_success "Context initialization" "./scripts/god-cli context init '$test_context'"
    assert_contains "Context list shows new context" "./scripts/god-cli context list" "$test_context"
    assert_success "Context add data" "./scripts/god-cli context add '$test_context' test_key 'test_value'"
    assert_contains "Context get data" "./scripts/god-cli context get '$test_context' test_key" "test_value"
    assert_success "Context cleanup" "./scripts/god-cli context cleanup 1"
}

test_caching_system() {
    echo -e "\n${BLUE}=== Caching System Tests ===${NC}"
    
    local test_cache_key="test-cache-$$"
    local test_content="Test cached content $(date)"
    local output_file="$TEMP_TEST_DIR/cache-test-output.txt"
    
    # Test cache lifecycle
    assert_success "Cache store operation" "./scripts/god-cli-cache cache scripts/ '$test_cache_key' '$test_content' 300"
    assert_success "Cache retrieve operation" "./scripts/god-cli-cache get scripts/ '$test_cache_key' '$output_file'"
    assert_contains "Cached content correct" "cat '$output_file'" "$test_content"
    assert_contains "Cache stats work" "./scripts/god-cli-cache stats" "God-CLI Cache Statistics"
    
    # Cleanup
    rm -f "$output_file"
    ./scripts/god-cli-cache cleanup 1 2>/dev/null || true
}

test_workflow_system() {
    echo -e "\n${BLUE}=== Workflow System Tests ===${NC}"
    
    local test_workflow="test-workflow-$$"
    
    # Test workflow lifecycle
    assert_success "Workflow initialization" "./scripts/god-cli-workflow init '$test_workflow'"
    assert_success "Add workflow task" "./scripts/god-cli-workflow add-task '$test_workflow' task1 claude 'test task' '' 10"
    assert_success "Add second task" "./scripts/god-cli-workflow add-task '$test_workflow' task2 claude 'test task 2' '' 10"  
    assert_success "Add dependency" "./scripts/god-cli-workflow add-dependency '$test_workflow' task2 task1"
    assert_contains "Workflow planning" "./scripts/god-cli-workflow plan '$test_workflow'" "Generated execution plan"
    assert_contains "Workflow status" "./scripts/god-cli-workflow status '$test_workflow'" "Workflow Summary"
    assert_contains "Workflow list" "./scripts/god-cli-workflow list" "$test_workflow"
    
    # Cleanup
    rm -f "${HOME}/.god-cli/workflows/${test_workflow}.json" 2>/dev/null || true
}

test_integration_scenarios() {
    echo -e "\n${BLUE}=== Integration Scenario Tests ===${NC}"
    
    # Test auto-selection (if agents available)
    if command -v gemini >/dev/null; then
        assert_contains "Auto-selection works" "timeout 10 ./scripts/god-cli auto 'test auto selection' --scope=scripts/" "Auto-selected agent:"
    else
        skip_test "Auto-selection test" "gemini not available for complex selection"
    fi
    
    # Test routing with available agents
    if command -v codex >/dev/null || [[ -x "./scripts/safe-codex-exec" ]]; then
        assert_contains "Codex routing works" "timeout 10 ./scripts/god-cli route codex 'simple test' 2>&1 || true" "Routing request to codex"
    else
        skip_test "Codex routing test" "codex not available"
    fi
    
    # Test Claude routing (should always work)
    assert_contains "Claude routing works" "timeout 5 ./scripts/god-cli route claude 'test prompt' 2>&1 || true" "Claude execution:"
}

test_error_handling() {
    echo -e "\n${BLUE}=== Error Handling Tests ===${NC}"
    
    # Test invalid commands
    assert_success "Invalid god-cli command fails gracefully" "! ./scripts/god-cli invalid-command 2>/dev/null"
    assert_success "Invalid workflow command fails gracefully" "! ./scripts/god-cli-workflow invalid-command 2>/dev/null"
    assert_success "Invalid cache command fails gracefully" "! ./scripts/god-cli-cache invalid-command 2>/dev/null"
    
    # Test missing required arguments
    assert_success "Missing god-cli args fail gracefully" "! ./scripts/god-cli route 2>/dev/null"
    assert_success "Missing workflow args fail gracefully" "! ./scripts/god-cli-workflow add-task 2>/dev/null"
    assert_success "Missing cache args fail gracefully" "! ./scripts/god-cli-cache cache 2>/dev/null"
    
    # Test fallback when preferred agent unavailable
    assert_contains "Fallback handles unavailable agents" "./scripts/god-cli-fallback execute nonexistent-agent 'test task' 2>&1 || true" "No agents available"
}

test_performance_monitoring() {
    echo -e "\n${BLUE}=== Performance Monitoring Tests ===${NC}"
    
    # Test monitoring commands (basic functionality)
    assert_success "Monitor measure works" "./scripts/god-cli-monitor measure test-operation echo 'test'"
    assert_contains "Monitor analyze works" "./scripts/god-cli-monitor analyze 1" "God-CLI Performance Analysis"
    
    # Test benchmarking (if we have time and agents)
    if command -v jq >/dev/null; then
        assert_success "Benchmark context operations" "./scripts/god-cli-monitor benchmark context-init scripts/ 2"
    else
        skip_test "Benchmark tests" "jq not available"
    fi
}

# Test execution control
run_test_category() {
    local category="$1"
    
    case "$category" in
        "basic")
            test_basic_functionality
            ;;
        "agents")
            test_agent_availability
            ;;
        "context")
            test_context_management
            ;;
        "cache")
            test_caching_system
            ;;
        "workflow")
            test_workflow_system
            ;;
        "integration")
            test_integration_scenarios
            ;;
        "errors")
            test_error_handling
            ;;
        "performance")
            test_performance_monitoring
            ;;
        "all")
            test_basic_functionality
            test_agent_availability
            test_context_management
            test_caching_system
            test_workflow_system
            test_integration_scenarios
            test_error_handling
            test_performance_monitoring
            ;;
        *)
            echo "Unknown test category: $category"
            exit 1
            ;;
    esac
}

# Generate test report
generate_report() {
    local report_file="${TEST_RESULTS_DIR}/integration-test-report-$(date +%Y-%m-%d-%H%M%S).md"
    
    {
        echo "# God-CLI Integration Test Report"
        echo "Generated: $(date)"
        echo ""
        
        echo "## Summary"
        echo "- **Passed**: ${#passed_tests[@]}"
        echo "- **Failed**: ${#failed_tests[@]}"
        echo "- **Skipped**: ${#skipped_tests[@]}"
        echo "- **Total**: $((${#passed_tests[@]} + ${#failed_tests[@]} + ${#skipped_tests[@]}))"
        echo ""
        
        local success_rate=0
        local total_tests=$((${#passed_tests[@]} + ${#failed_tests[@]}))
        if [[ $total_tests -gt 0 ]]; then
            success_rate=$(echo "scale=1; ${#passed_tests[@]} * 100 / $total_tests" | bc -l)
        fi
        echo "- **Success Rate**: ${success_rate}%"
        echo ""
        
        if [[ ${#failed_tests[@]} -gt 0 ]]; then
            echo "## Failed Tests"
            for test in "${failed_tests[@]}"; do
                echo "- ❌ $test"
            done
            echo ""
        fi
        
        if [[ ${#skipped_tests[@]} -gt 0 ]]; then
            echo "## Skipped Tests"
            for test in "${skipped_tests[@]}"; do
                echo "- ⚠️  $test"
            done
            echo ""
        fi
        
        echo "## System Information"
        echo "- Test Environment: $(uname -a)"
        echo "- God-CLI Version: $VERSION"
        echo "- Test Date: $(date)"
        echo "- Available Agents:"
        command -v codex >/dev/null && echo "  - Codex: Available" || echo "  - Codex: Not Available"
        command -v gemini >/dev/null && echo "  - Gemini: Available" || echo "  - Gemini: Not Available"
        echo "  - Claude: Available (native)"
        
    } > "$report_file"
    
    echo ""
    echo -e "${BLUE}📋 Test report generated: $report_file${NC}"
}

# Usage information
usage() {
    cat << EOF
$SCRIPT_NAME v$VERSION - God-CLI Integration Test Suite

Usage:
  $SCRIPT_NAME [test-category] [--verbose]
  $SCRIPT_NAME --help

Test Categories:
  basic         Test basic functionality and script availability
  agents        Test agent availability and routing
  context       Test context management system
  cache         Test caching system functionality
  workflow      Test workflow orchestration
  integration   Test end-to-end integration scenarios
  errors        Test error handling and edge cases
  performance   Test performance monitoring
  all           Run all test categories (default)

Options:
  --verbose     Show detailed debug output
  --help        Show this help message

Examples:
  $SCRIPT_NAME                    # Run all tests
  $SCRIPT_NAME basic             # Run only basic functionality tests
  $SCRIPT_NAME workflow --verbose # Run workflow tests with debug output

Test Results:
  Report Location: $TEST_RESULTS_DIR
  Logs: $LOG_FILE

The test suite validates:
- ✅ All god-cli scripts are executable and functional
- ✅ Agent availability and routing works correctly  
- ✅ Context management lifecycle (init, add, get, cleanup)
- ✅ Caching system with file change detection
- ✅ Workflow orchestration with dependency tracking
- ✅ Integration between all components
- ✅ Error handling and graceful failures
- ✅ Performance monitoring and benchmarking
EOF
}

# Main execution
main() {
    local test_category="all"
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose)
                export VERBOSE=1
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            basic|agents|context|cache|workflow|integration|errors|performance|all)
                test_category="$1"
                shift
                ;;
            *)
                echo "Unknown argument: $1"
                usage
                exit 1
                ;;
        esac
    done
    
    echo -e "${BLUE}🧪 God-CLI Integration Test Suite${NC}"
    echo -e "Version: $VERSION"
    echo -e "Category: $test_category"
    echo -e "Verbose: ${VERBOSE:-0}"
    
    log "Starting integration tests (category: $test_category)"
    
    # Run tests
    run_test_category "$test_category"
    
    # Show results summary
    echo ""
    echo -e "${BLUE}=== Test Results Summary ===${NC}"
    echo -e "${GREEN}Passed:${NC} ${#passed_tests[@]}"
    echo -e "${RED}Failed:${NC} ${#failed_tests[@]}"
    echo -e "${YELLOW}Skipped:${NC} ${#skipped_tests[@]}"
    
    local total_tests=$((${#passed_tests[@]} + ${#failed_tests[@]} + ${#skipped_tests[@]}))
    echo -e "Total: $total_tests"
    
    if [[ ${#failed_tests[@]} -eq 0 ]]; then
        echo -e "\n${GREEN}🎉 All tests passed!${NC}"
    else
        echo -e "\n${RED}⚠️  Some tests failed. Check the details above.${NC}"
    fi
    
    # Generate report
    generate_report
    
    # Cleanup
    rm -rf "$TEMP_TEST_DIR" 2>/dev/null || true
    
    # Exit with appropriate code
    [[ ${#failed_tests[@]} -eq 0 ]]
}

# Execute main function if script is run directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi