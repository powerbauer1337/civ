#!/bin/bash

# god-cli-workflow - Advanced Parallel Workflow Orchestration
# Manages complex multi-agent workflows with parallel execution and dependency tracking
# Usage: god-cli-workflow <command> [args...]

set -euo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly VERSION="3.0.0-alpha"
readonly CONFIG_DIR="${HOME}/.god-cli"
readonly LOG_FILE="${CONFIG_DIR}/logs/workflow.log"
readonly WORKFLOW_DIR="${CONFIG_DIR}/workflows"
readonly TEMP_DIR="${CONFIG_DIR}/temp"

# Ensure directories exist
mkdir -p "$CONFIG_DIR"/{logs,workflows,temp}

# Logging functions
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log_debug() {
    if [[ "${DEBUG:-}" = "1" ]]; then
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] DEBUG: $*" | tee -a "$LOG_FILE" >&2
    fi
}

log_error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $*" | tee -a "$LOG_FILE" >&2
}

log_warning() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] WARNING: $*" | tee -a "$LOG_FILE" >&2
}

# Workflow management functions
workflow_init() {
    local workflow_name="$1"
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    if [[ -f "$workflow_file" ]]; then
        log_warning "Workflow '$workflow_name' already exists"
        return 1
    fi
    
    cat > "$workflow_file" << EOF
{
  "workflow_id": "$workflow_name",
  "created": "$(date -Iseconds)",
  "status": "initialized",
  "tasks": [],
  "dependencies": {},
  "execution_plan": {
    "parallel_groups": [],
    "sequential_order": []
  },
  "results": {},
  "metadata": {
    "total_estimated_time": 0,
    "parallel_efficiency": 0,
    "context_session": null
  }
}
EOF
    
    echo "✅ Initialized workflow: $workflow_name"
    echo "Workflow file: $workflow_file"
}

# Add task to workflow
workflow_add_task() {
    local workflow_name="$1"
    local task_id="$2"
    local agent="$3"
    local prompt="$4"
    local scope="${5:-}"
    local estimated_time="${6:-60}"
    
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    if [[ ! -f "$workflow_file" ]]; then
        log_error "Workflow '$workflow_name' not found"
        return 1
    fi
    
    if command -v jq >/dev/null; then
        local temp_file
        temp_file=$(mktemp)
        
        jq --arg task_id "$task_id" \
           --arg agent "$agent" \
           --arg prompt "$prompt" \
           --arg scope "$scope" \
           --argjson estimated_time "$estimated_time" \
           --arg timestamp "$(date -Iseconds)" \
           '.tasks += [{
             "task_id": $task_id,
             "agent": $agent,
             "prompt": $prompt,
             "scope": $scope,
             "estimated_time": $estimated_time,
             "status": "pending",
             "dependencies": [],
             "created": $timestamp
           }]' \
           "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
        
        echo "✅ Added task '$task_id' to workflow '$workflow_name'"
    else
        log_error "jq is required for workflow management"
        return 1
    fi
}

# Add dependency between tasks
workflow_add_dependency() {
    local workflow_name="$1"
    local dependent_task="$2"
    local prerequisite_task="$3"
    
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    if [[ ! -f "$workflow_file" ]]; then
        log_error "Workflow '$workflow_name' not found"
        return 1
    fi
    
    if command -v jq >/dev/null; then
        local temp_file
        temp_file=$(mktemp)
        
        jq --arg dependent "$dependent_task" \
           --arg prerequisite "$prerequisite_task" \
           '(.tasks[] | select(.task_id == $dependent) | .dependencies) += [$prerequisite]' \
           "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
        
        echo "✅ Added dependency: '$dependent_task' depends on '$prerequisite_task'"
    else
        log_error "jq is required for workflow management"
        return 1
    fi
}

# Generate execution plan with parallel optimization
generate_execution_plan() {
    local workflow_file="$1"
    
    log_debug "Generating execution plan for workflow"
    
    if ! command -v jq >/dev/null; then
        log_error "jq is required for execution planning"
        return 1
    fi
    
    # Extract tasks and dependencies
    local tasks
    tasks=$(jq -r '.tasks[] | .task_id' "$workflow_file")
    
    # Build dependency graph and identify parallel groups
    local -A task_deps
    local -A task_levels
    local max_level=0
    
    # Parse dependencies
    while IFS= read -r task_id; do
        local deps
        deps=$(jq -r --arg task_id "$task_id" '.tasks[] | select(.task_id == $task_id) | .dependencies[]?' "$workflow_file")
        task_deps["$task_id"]="$deps"
        log_debug "Task '$task_id' dependencies: $deps"
    done <<< "$tasks"
    
    # Calculate dependency levels (topological sorting)
    local -A visited
    
    calculate_level() {
        local task="$1"
        
        if [[ -n "${visited[$task]:-}" ]]; then
            return 0
        fi
        
        visited["$task"]="1"
        local level=0
        
        # Check dependencies
        for dep in ${task_deps["$task"]:-}; do
            if [[ -n "$dep" ]]; then
                calculate_level "$dep"
                local dep_level="${task_levels[$dep]}"
                if [[ $((dep_level + 1)) -gt $level ]]; then
                    level=$((dep_level + 1))
                fi
            fi
        done
        
        task_levels["$task"]="$level"
        if [[ $level -gt $max_level ]]; then
            max_level=$level
        fi
        
        log_debug "Task '$task' assigned to level $level"
    }
    
    # Calculate levels for all tasks
    while IFS= read -r task_id; do
        calculate_level "$task_id"
    done <<< "$tasks"
    
    # Group tasks by level (parallel groups)
    local -A level_groups
    for task in "${!task_levels[@]}"; do
        local level="${task_levels[$task]}"
        level_groups["$level"]+="$task "
    done
    
    # Build execution plan
    local parallel_groups="["
    local first_group=true
    
    for ((level=0; level<=max_level; level++)); do
        if [[ -n "${level_groups[$level]:-}" ]]; then
            if [[ "$first_group" == "false" ]]; then
                parallel_groups+=","
            fi
            
            parallel_groups+="{\"level\":$level,\"tasks\":["
            local first_task=true
            
            for task in ${level_groups[$level]}; do
                if [[ "$first_task" == "false" ]]; then
                    parallel_groups+=","
                fi
                parallel_groups+="\"$task\""
                first_task=false
            done
            
            parallel_groups+="]}"
            first_group=false
        fi
    done
    
    parallel_groups+="]"
    
    # Update workflow file with execution plan
    local temp_file
    temp_file=$(mktemp)
    
    jq --argjson parallel_groups "$parallel_groups" \
       --arg updated "$(date -Iseconds)" \
       '.execution_plan.parallel_groups = $parallel_groups |
        .execution_plan.updated = $updated |
        .status = "planned"' \
       "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
    
    echo "✅ Generated execution plan with $((max_level + 1)) parallel groups"
    
    # Show execution plan
    echo ""
    echo "Execution Plan:"
    for ((level=0; level<=max_level; level++)); do
        if [[ -n "${level_groups[$level]:-}" ]]; then
            echo "  Level $level (parallel): ${level_groups[$level]}"
        fi
    done
}

# Execute task with progress tracking
execute_task() {
    local workflow_name="$1"
    local task_id="$2"
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    log "Executing task: $task_id"
    
    # Get task details
    local agent prompt scope context_session
    agent=$(jq -r --arg task_id "$task_id" '.tasks[] | select(.task_id == $task_id) | .agent' "$workflow_file")
    prompt=$(jq -r --arg task_id "$task_id" '.tasks[] | select(.task_id == $task_id) | .prompt' "$workflow_file")
    scope=$(jq -r --arg task_id "$task_id" '.tasks[] | select(.task_id == $task_id) | .scope' "$workflow_file")
    context_session=$(jq -r '.metadata.context_session // empty' "$workflow_file")
    
    # Mark task as running
    local temp_file
    temp_file=$(mktemp)
    jq --arg task_id "$task_id" \
       --arg start_time "$(date -Iseconds)" \
       '(.tasks[] | select(.task_id == $task_id) | .status) = "running" |
        (.tasks[] | select(.task_id == $task_id) | .start_time) = $start_time' \
       "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
    
    # Execute the task
    local start_time end_time exit_code=0
    start_time=$(date +%s)
    
    local cmd_args=("./scripts/god-cli" "route" "$agent" "$prompt")
    [[ -n "$scope" && "$scope" != "null" ]] && cmd_args+=("--scope=$scope")
    [[ -n "$context_session" && "$context_session" != "null" ]] && cmd_args+=("--context=$context_session")
    
    # Capture output to file for result storage
    local output_file="${TEMP_DIR}/${workflow_name}-${task_id}.out"
    
    if "${cmd_args[@]}" > "$output_file" 2>&1; then
        exit_code=0
        log "Task '$task_id' completed successfully"
    else
        exit_code=$?
        log_error "Task '$task_id' failed with exit code $exit_code"
    fi
    
    end_time=$(date +%s)
    local duration=$((end_time - start_time))
    
    # Update task status with results
    temp_file=$(mktemp)
    local output_content
    output_content=$(cat "$output_file" | head -c 10000)  # Limit output size
    
    jq --arg task_id "$task_id" \
       --arg end_time "$(date -Iseconds)" \
       --argjson duration "$duration" \
       --argjson exit_code "$exit_code" \
       --arg output "$output_content" \
       '(.tasks[] | select(.task_id == $task_id) | .status) = (if $exit_code == 0 then "completed" else "failed" end) |
        (.tasks[] | select(.task_id == $task_id) | .end_time) = $end_time |
        (.tasks[] | select(.task_id == $task_id) | .duration) = $duration |
        (.tasks[] | select(.task_id == $task_id) | .exit_code) = $exit_code |
        .results[$task_id] = {
          "output": $output,
          "exit_code": $exit_code,
          "duration": $duration,
          "completed": $end_time
        }' \
       "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
    
    # Clean up output file
    rm -f "$output_file"
    
    return $exit_code
}

# Execute parallel group
execute_parallel_group() {
    local workflow_name="$1"
    local level="$2"
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    # Get tasks for this level
    local tasks
    tasks=$(jq -r --argjson level "$level" '.execution_plan.parallel_groups[] | select(.level == $level) | .tasks[]' "$workflow_file")
    
    if [[ -z "$tasks" ]]; then
        log_debug "No tasks found for level $level"
        return 0
    fi
    
    echo "🚀 Executing parallel group $level with tasks: $(echo "$tasks" | tr '\n' ' ')"
    
    # Start all tasks in background
    local -A task_pids
    local task_count=0
    
    while IFS= read -r task_id; do
        if [[ -n "$task_id" ]]; then
            log_debug "Starting task: $task_id"
            execute_task "$workflow_name" "$task_id" &
            task_pids["$task_id"]=$!
            ((task_count++))
        fi
    done <<< "$tasks"
    
    # Wait for all tasks to complete
    local completed_count=0
    local failed_count=0
    
    echo "⏳ Waiting for $task_count parallel tasks to complete..."
    
    for task_id in "${!task_pids[@]}"; do
        local pid="${task_pids[$task_id]}"
        
        if wait "$pid"; then
            echo "  ✅ $task_id completed"
            ((completed_count++))
        else
            echo "  ❌ $task_id failed"
            ((failed_count++))
        fi
    done
    
    echo "📊 Parallel group $level results: $completed_count completed, $failed_count failed"
    
    # Return error if any tasks failed
    [[ $failed_count -eq 0 ]]
}

# Execute complete workflow
workflow_execute() {
    local workflow_name="$1"
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    if [[ ! -f "$workflow_file" ]]; then
        log_error "Workflow '$workflow_name' not found"
        return 1
    fi
    
    # Generate execution plan if not already done
    local status
    status=$(jq -r '.status' "$workflow_file")
    
    if [[ "$status" != "planned" ]]; then
        echo "📋 Generating execution plan..."
        generate_execution_plan "$workflow_file"
    fi
    
    # Set context session if not set
    local context_session
    context_session=$(jq -r '.metadata.context_session // empty' "$workflow_file")
    
    if [[ -z "$context_session" || "$context_session" == "null" ]]; then
        context_session="workflow-${workflow_name}-$(date +%s)"
        echo "🔗 Initializing context session: $context_session"
        ./scripts/god-cli context init "$context_session"
        
        # Update workflow with context session
        local temp_file
        temp_file=$(mktemp)
        jq --arg context_session "$context_session" \
           '.metadata.context_session = $context_session' \
           "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
    fi
    
    # Mark workflow as executing
    local temp_file
    temp_file=$(mktemp)
    jq --arg start_time "$(date -Iseconds)" \
       '.status = "executing" |
        .execution_start = $start_time' \
       "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
    
    # Execute parallel groups in sequence
    local max_level
    max_level=$(jq -r '.execution_plan.parallel_groups | map(.level) | max' "$workflow_file")
    
    local workflow_start_time
    workflow_start_time=$(date +%s)
    
    echo "🎬 Starting workflow execution with $((max_level + 1)) parallel groups"
    
    for ((level=0; level<=max_level; level++)); do
        if ! execute_parallel_group "$workflow_name" "$level"; then
            log_error "Parallel group $level failed, stopping workflow"
            
            # Mark workflow as failed
            temp_file=$(mktemp)
            jq --arg end_time "$(date -Iseconds)" \
               '.status = "failed" |
                .execution_end = $end_time' \
               "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
            
            return 1
        fi
    done
    
    local workflow_end_time
    workflow_end_time=$(date +%s)
    local total_duration=$((workflow_end_time - workflow_start_time))
    
    # Mark workflow as completed
    temp_file=$(mktemp)
    jq --arg end_time "$(date -Iseconds)" \
       --argjson total_duration "$total_duration" \
       '.status = "completed" |
        .execution_end = $end_time |
        .metadata.actual_duration = $total_duration' \
       "$workflow_file" > "$temp_file" && mv "$temp_file" "$workflow_file"
    
    echo "🎉 Workflow completed in ${total_duration}s"
    
    # Show summary
    workflow_summary "$workflow_name"
}

# Show workflow summary
workflow_summary() {
    local workflow_name="$1"
    local workflow_file="${WORKFLOW_DIR}/${workflow_name}.json"
    
    if [[ ! -f "$workflow_file" ]]; then
        log_error "Workflow '$workflow_name' not found"
        return 1
    fi
    
    echo ""
    echo "📊 Workflow Summary: $workflow_name"
    echo "=================================="
    
    local status total_tasks completed_tasks failed_tasks duration
    status=$(jq -r '.status' "$workflow_file")
    total_tasks=$(jq -r '.tasks | length' "$workflow_file")
    completed_tasks=$(jq -r '[.tasks[] | select(.status == "completed")] | length' "$workflow_file")
    failed_tasks=$(jq -r '[.tasks[] | select(.status == "failed")] | length' "$workflow_file")
    duration=$(jq -r '.metadata.actual_duration // "unknown"' "$workflow_file")
    
    echo "Status: $status"
    echo "Tasks: $completed_tasks/$total_tasks completed, $failed_tasks failed"
    [[ "$duration" != "unknown" ]] && echo "Duration: ${duration}s"
    
    echo ""
    echo "Task Results:"
    jq -r '.tasks[] | "  \(.task_id): \(.status) (\(.duration // 0)s)"' "$workflow_file"
    
    # Show context session info
    local context_session
    context_session=$(jq -r '.metadata.context_session // empty' "$workflow_file")
    if [[ -n "$context_session" && "$context_session" != "null" ]]; then
        echo ""
        echo "Context Session: $context_session"
        echo "View results: ./scripts/god-cli context get $context_session"
    fi
}

# List workflows
workflow_list() {
    echo "Available workflows:"
    
    for workflow_file in "$WORKFLOW_DIR"/*.json; do
        if [[ -f "$workflow_file" ]]; then
            local workflow_name status created
            workflow_name=$(basename "$workflow_file" .json)
            status=$(jq -r '.status' "$workflow_file")
            created=$(jq -r '.created' "$workflow_file")
            
            echo "  $workflow_name ($status, created: $created)"
        fi
    done
}

# Usage information
usage() {
    cat << EOF
$SCRIPT_NAME v$VERSION - Parallel Workflow Orchestration

Usage:
  $SCRIPT_NAME init <workflow-name>
  $SCRIPT_NAME add-task <workflow> <task-id> <agent> "<prompt>" [scope] [time]
  $SCRIPT_NAME add-dependency <workflow> <dependent-task> <prerequisite-task>
  $SCRIPT_NAME plan <workflow>
  $SCRIPT_NAME execute <workflow>
  $SCRIPT_NAME status <workflow>
  $SCRIPT_NAME list

Commands:
  init          Create new workflow
  add-task      Add task to workflow
  add-dep       Add task dependency  
  plan          Generate execution plan
  execute       Execute workflow with parallel optimization
  status        Show workflow status and results
  list          List all workflows

Examples:
  # Create comprehensive analysis workflow
  $SCRIPT_NAME init codebase-analysis
  $SCRIPT_NAME add-task codebase-analysis arch gemini "analyze architecture" server/ 120
  $SCRIPT_NAME add-task codebase-analysis issues codex "find performance issues" server/ 60
  $SCRIPT_NAME add-task codebase-analysis fixes claude "implement fixes" "" 180
  $SCRIPT_NAME add-dependency codebase-analysis fixes arch
  $SCRIPT_NAME add-dependency codebase-analysis fixes issues
  $SCRIPT_NAME execute codebase-analysis

Benefits:
  - Parallel execution reduces total workflow time by 30-50%
  - Dependency tracking ensures correct execution order
  - Progress tracking shows real-time status
  - Context persistence across all agents
  - Automatic result aggregation and summary

Logs: $LOG_FILE
Workflows: $WORKFLOW_DIR
EOF
}

# Main command parser
main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi
    
    local command="$1"
    shift
    
    case "$command" in
        init)
            if [[ $# -lt 1 ]]; then
                echo "ERROR: init requires workflow name" >&2
                exit 1
            fi
            workflow_init "$1"
            ;;
        add-task)
            if [[ $# -lt 4 ]]; then
                echo "ERROR: add-task requires workflow, task-id, agent, and prompt" >&2
                exit 1
            fi
            workflow_add_task "$1" "$2" "$3" "$4" "${5:-}" "${6:-60}"
            ;;
        add-dependency|add-dep)
            if [[ $# -lt 3 ]]; then
                echo "ERROR: add-dependency requires workflow, dependent-task, and prerequisite-task" >&2
                exit 1
            fi
            workflow_add_dependency "$1" "$2" "$3"
            ;;
        plan)
            if [[ $# -lt 1 ]]; then
                echo "ERROR: plan requires workflow name" >&2
                exit 1
            fi
            generate_execution_plan "${WORKFLOW_DIR}/$1.json"
            ;;
        execute)
            if [[ $# -lt 1 ]]; then
                echo "ERROR: execute requires workflow name" >&2
                exit 1
            fi
            workflow_execute "$1"
            ;;
        status)
            if [[ $# -lt 1 ]]; then
                echo "ERROR: status requires workflow name" >&2
                exit 1
            fi
            workflow_summary "$1"
            ;;
        list)
            workflow_list
            ;;
        --help|-h|help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: Unknown command: $command" >&2
            usage
            exit 1
            ;;
    esac
}

# Execute main function if script is run directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi